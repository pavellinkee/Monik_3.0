# Monik — пример переменных окружения.
# Скопировать в .env и заполнить реальными значениями. Файл .env в Git не попадает.
# Полный список формируется на этапе S3 вместе со схемой конфигурации.

# Aggregator API credentials
MONIK_ONEINCH_API_KEY=
MONIK_ZEROX_API_KEY=
MONIK_VELORA_API_KEY=
MONIK_UNISWAP_API_KEY=

# Telegram
MONIK_TELEGRAM_BOT_TOKEN=
MONIK_TELEGRAM_CHAT_ID=
